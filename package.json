{
  "name": "@octridev/vercel",
  "description": "**Unofficial SDK.** Generated by [Octri](https://octri.dev) from Vercel's public OpenAPI specification to showcase Octri's SDK generator. It is not affiliated with, maintained, or endorsed by Vercel.\n\nVercel combines the best developer experience with an obsessive focus on end-user performance. Our platform enables frontend teams to do their best work.",
  "version": "0.0.1",
  "keywords": [
    "vercel",
    "api",
    "sdk",
    "client"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OctriDev/vercel-typescript-showcase-sdk.git"
  },
  "homepage": "https://github.com/OctriDev/vercel-typescript-showcase-sdk",
  "bugs": {
    "url": "https://github.com/OctriDev/vercel-typescript-showcase-sdk/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "oxfmt --check src test/*.mjs",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.4.0"
  }
}
